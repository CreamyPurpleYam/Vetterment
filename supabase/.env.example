# PayPal Sandbox Configuration
# Copy this file to .env.local and fill in your Sandbox credentials
# NEVER commit .env.local or any file containing real secrets

# Required: PayPal REST API credentials for Sandbox environment
# Get these from: https://developer.paypal.com/dashboard/ → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Required: PayPal environment (sandbox or live)
PAYPAL_ENV=sandbox

# Optional: Expected merchant ID for payee validation
# Get from PayPal Developer Dashboard → Sandbox App → Live/Sandbox credentials
# EXPECTED_MERCHANT_ID=your-merchant-id

# Required: Supabase configuration for Edge Functions
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Custom return/cancel URLs for PayPal approval flow
# Must match the deep link scheme configured in AndroidManifest.xml
# PAYPAL_RETURN_URL=vetterment://payment-return
# PAYPAL_CANCEL_URL=vetterment://payment-cancel